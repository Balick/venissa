---
import Layout from "./Layout.astro";
import profile from "../data/profile.json";
import EntryArticle from "../components/EntryArticle";
type Props = Omit<
  import("react").ComponentProps<typeof EntryArticle>,
  "children"
>;
const { data, section } = Astro.props;
---

<Layout title={`${data.title} — ${profile.name}`} description={data.summary}>
  <EntryArticle data={data} section={section}>
    <slot />
  </EntryArticle>
</Layout>
