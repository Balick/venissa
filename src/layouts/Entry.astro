---
import Layout from "./Layout.astro";
import profile from "../data/profile.json";
interface Props {
  data: {
    title: string;
    summary: string;
    category: string;
    image?: string;
    alt?: string;
  };
  section: "work" | "journal";
}
const { data, section } = Astro.props;
---

<Layout title={`${data.title} — ${profile.name}`} description={data.summary}>
  <article class="wrap entry">
    <a class="back" href={`/#${section}`}>
      ← Back to {section}
    </a>
    <p class="eyebrow">{data.category}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>
    {data.image && (
      <a href={data.image} aria-label={`View ${data.title} at full size`}>
        <img class="entry-image" src={data.image} alt={data.alt} />
      </a>
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>
