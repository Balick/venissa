---
import services from "../data/services.json";
---

<section id="services" class="wrap section">
  <div class="eyebrow">
    <i></i> My services
  </div>
  <div class="heading">
    <h2>
      How I bring <em>ideas to life.</em>
    </h2>
    <a class="link" href="#contact">
      Discuss a project
      <img class="icon" src="/icons/arrow-up-right.svg" alt="" />
    </a>
  </div>
  <div class="services">
    {services.map((service, index) => (
      <details name="service" open={index === 1}>
        <summary>
          <small>{String(index + 1).padStart(2, "0")} /</small>
          <strong>{service.title}</strong>
          <i>
            <img class="icon" src="/icons/arrow-up-right.svg" alt="" />
          </i>
        </summary>
        <div class="service-body">
          <div>
            {service.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
          <p>{service.description}</p>
        </div>
      </details>
    ))}
  </div>
</section>
