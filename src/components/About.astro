---
import profile from "../data/profile.json";
---

<section id="about" class="dark">
  <div class="wrap about">
    <div class="about-photo">
      <img loading="lazy" src={profile.studioPortrait} alt={profile.name} />
    </div>
    <div>
      <div class="eyebrow">
        <i></i> About me
      </div>
      <h2>
        Who is <em>{profile.name}?</em>
      </h2>
      <p>{profile.bio}</p>
      <a class="link" href="#work">
        Explore my work
        <img class="icon" src="/icons/arrow-right.svg" alt="" />
      </a>
    </div>
  </div>
</section>
