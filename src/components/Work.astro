---
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categories = [
  ...new Set(projects.map((project) => project.data.category)),
];
---

<section id="work" class="section wrap">
  <div class="eyebrow">
    <i></i> My portfolio
  </div>
  <h2>
    Selected <em>work.</em>
  </h2>
  <div class="filters" aria-label="Filter projects" role="group" hidden>
    {["All", ...categories].map((label, i) => (
      <button type="button" aria-pressed={i === 0} data-filter={label}>
        {label}
      </button>
    ))}
  </div>
  <div class="projects">
    {projects.map(({ id, data }) => (
      <div class="project-card" data-category={data.category}>
        <a href={`/work/${id}/`}>
          <img src={data.image} alt={data.alt} loading="lazy" />
          <div class="project-title">
            {data.title} <span aria-hidden="true">↗</span>
          </div>
        </a>
      </div>
    ))}
  </div>
  <p class="visually-hidden" role="status" id="filter-status"></p>
</section>
<script>
  const filters = document.querySelector<HTMLElement>(".filters")!;
  const cards = document.querySelectorAll<HTMLElement>("[data-category]");
  filters.hidden = false;
  filters.addEventListener("click", (event) => {
    const button =
      event.target instanceof Element &&
      event.target.closest<HTMLButtonElement>("button[data-filter]");
    if (!button) return;
    for (const control of filters.querySelectorAll("button"))
      control.setAttribute("aria-pressed", String(control === button));
    let count = 0;
    for (const card of cards) {
      card.hidden =
        button.dataset.filter !== "All" &&
        button.dataset.filter !== card.dataset.category;
      if (!card.hidden) count++;
    }
    document.querySelector("#filter-status")!.textContent =
      `${count} projects shown`;
  });
</script>
