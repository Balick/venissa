---
import profile from "../data/profile.json";
---

<header class="top">
  <a class="brand" href="/#home">
    <i>
      <img class="icon" src="/icons/asterisk.svg" alt="" />
    </i>
    {profile.brand}
    <span>.</span>
  </a>
  <nav id="navigation" aria-label="Main navigation">
    {["Home", "Services", "Work", "Journal", "About"].map((label) => (
      <a href={`/#${label.toLowerCase()}`}>{label}</a>
    ))}
  </nav>
  <a class="talk" href="/#contact">
    Let’s talk
    <img class="icon" src="/icons/arrow-up-right.svg" alt="" />
  </a>
  <button
    class="menu"
    aria-label="Open navigation"
    aria-controls="navigation"
    aria-expanded="false"
  >
    <img class="icon" src="/icons/list.svg" alt="" />
  </button>
</header>
<script>
  import "../js/portfolio.js";
</script>
