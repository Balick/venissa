---
import steps from "../data/process.json";
---

<section class="wrap process">
  <div class="eyebrow">
    <i></i> My process
  </div>
  <h2>
    From brief <em>to delivery.</em>
  </h2>
  <ol>
    {steps.map((step) => (
      <li>
        <h3>{step.title}</h3>
        <p>{step.description}</p>
      </li>
    ))}
  </ol>
</section>
